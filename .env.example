# ─────────────────────────────────────────────
#  Variables de entorno de CromIA
#  Copia este archivo como .env.local para desarrollo
#  y configura las mismas variables en Vercel.
# ─────────────────────────────────────────────

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Correo que recibirá los mensajes del formulario (puedes poner varios separados por coma)
CONTACT_TO_EMAIL=

# (Opcional) Remitente de los correos. Debe pertenecer a un dominio verificado en Resend.
# Si lo dejas vacío se usa "CromIA <onboarding@resend.dev>", que solo sirve para pruebas
# y únicamente entrega correos al email dueño de la cuenta de Resend.
CONTACT_FROM_EMAIL=

# (Opcional) URL pública del sitio, sin "/" final. Ej: https://www.cromia.co
# En Vercel, si no la defines, se usa automáticamente el dominio de producción del proyecto.
NEXT_PUBLIC_SITE_URL=
